

#include "../define.h"

#define ad_times			10
#define ad_abandon_times	4

#define V_overload			32//待测定，mos高温时的D和S压降，
#define V_lowload			6

//#define ad_mos_overload		((420-V_overload)*4095*ad_times*10/12/420)//过载保护AD值
#define ad_mos_overload	((420-V_overload)*4095*ad_times/420)//过载保护AD值
#define ad_VDD_smoking_low	(120*4095*ad_times/VDD_smoking_low_data)//输出中的低压保护AD值

byte ad_count, load_delay_count, load_low_count;
word ad_value, VDD, VDD_protect, V_out, VDD_smoking;
eword ad_sum, ad_sum_bandgap;
byte ad_turn, charge_remove_delay;

byte ad_charge_turn;

dword ad_cal_dword;

byte VDD_smoking_low_delay;

byte r_ad_flag;
bit flag_mos_pre		:r_ad_flag.0;
bit	flag_mos_ever_off	:r_ad_flag.1;


void short_protect_deal(void);//短路保护处理
void short_io_protect(void);//短路保护监测


void ad_get(void)
{
	if(!AD_Start)
	{
		return;
	}

	ad_value = (adcrh << 8 | adcrl);
 	ad_value =  ad_value >> 4;  

	if(ad_count >= ad_abandon_times)
	{
		ad_sum += ad_value;//adcr;
	}

	AD_Start = 1;		//开始

	if((flag_mos && ((!flag_mos_pre) || (flag_mos_ever_off))) || ((!flag_mos) && flag_mos_pre))
	{
		ad_reset();
		flag_mos_ever_off = 0;
		if(flag_mos)
		{
			flag_mos_pre = 1;
		}
		else
		{
			flag_mos_pre = 0;
		}
		return;
	}

	ad_count ++;
	if(ad_count >= ad_times + ad_abandon_times)
	{
		ad_deal();
		ad_count = 0;
		ad_sum = 0;
	}
}



void ad_deal(void)
{
	if(ad_turn == 0)
	{
	   	ad_sum_bandgap = ad_sum;

		if(flag_mos_pre)//采集过程mos状态为打开
		{
			p_check_ad_in();
			$ adcc enable, p_check_ad;
			ad_turn ++;

			math_word0 = ad_sum_bandgap;
			if(flag_pre_heat)
			{
//				math_word = mos_duty_max*180*10/120/12;
				math_word = mos_duty_max*200/120;//无分压电阻
			}
			else
			{
//				if(!V_out_degree)			math_word = mos_duty_max*420*10/120/12;
//				elseif(V_out_degree == 1)	math_word = mos_duty_max*270*10/120/12;
//				else						math_word = mos_duty_max*340*10/120/12;//有分压电阻

				if(!V_out_degree)			math_word = mos_duty_max*360/120;
				elseif(V_out_degree == 1)	math_word = mos_duty_max*400/120;
				else						math_word = mos_duty_max*300/120;//无分压电阻			
			}
			Math_Word_Mul_Word();
			ad_cal_dword = math_dword;
			if((ad_sum > ad_VDD_smoking_low) && (flag_smoking || flag_pre_heat))//输出中的低压判断
			{
				VDD_smoking_low_delay ++;
				if(VDD_smoking_low_delay >= 10)
				{
					VDD_smoking_low_delay = 0;
					mos_duty = 0;
					mos_off();			//关闭输出
		//			flag_overload = 1;
					flag_smoking = 0;
					flag_pre_heat = 0;
					clear_led_select();
					flag_led_r = 1;
//						V_out_degree = 0;
					led_blink_delay = 0;	//闪烁，需要清零闪烁计时
					led_blink_count = blink_low*2+1;//低压警报
//					led_blink_half_circle = 40;
//					flag_blink_force = 1;	//设为强制，闪烁过程清除连击状态
				}
			}
			else	VDD_smoking_low_delay = 0;
		}
		else
		{

		#if(Screw_charge_off_mode == Check_off_charge_fast)
			if(flag_charge)
			{
				p_check_ad_in();
				$ adcc enable, p_check_ad;
				ad_turn ++;
			}
		#endif
			math_eword = ad_sum;
			math_dword = 120*4096*ad_times;//1.2V,AD次数
			Math_Dword_Div_Eword();
			VDD = math_dword;//采集不带载电池电压
			VDD_smoking_low_delay = 0;
		}
	}
	else if(ad_turn == 1)
	{
//	  $ adcc enable, ADC;
	  $ adcc enable, BANDGAP;//363
		p_check_io_in();

		if(flag_mos_pre)
		{
			if(ad_sum < ad_mos_overload)
			{
				p_test_1;
				mos_duty = 0;
				mos_off();			//紧急关闭输出
//				flag_overload = 1;
				flag_charge = 0;
				flag_smoking = 0;
				flag_pre_heat = 0;
//				V_out_degree = 0;
				clear_led_select();
				flag_led_r = 1;
				led_blink_count = blink_overload*2+1;//闪烁三次
//				led_blink_half_circle = 50;
				led_blink_delay = 30;	//闪烁，需要清零闪烁计时
//				flag_blink_force = 1;	//设为强制，闪烁过程清除连击状态
			}
		}
		//--------------充电fast检测断开充电-------------------//
	#if(Screw_charge_off_mode == Check_off_charge_fast)
		else if(flag_charge)
		{
			if(!flag_full)
			{
				mos_duty = mos_duty_max;
				mos_on();
			}
//			if(ad_sum < ((420-30)*4095*ad_times*10/12/420))
			if(ad_sum < ((420-30)*4095*ad_times/420))
			{
				charge_disconnect_count_fast ++;
				if(charge_disconnect_count_fast > 25)
				{
					charge_disconnect_count_fast = 0;
					flag_charge = 0;//充电断开

					clear_led_select();
					flag_led_r = 1;
					led_blink_count = blink_off_charge*2+1;//闪烁
					led_blink_delay = 0;	//闪烁，需要清零闪烁计时
//						led_blink_half_circle = 40;	
				}
			}
			else
			{
				charge_disconnect_count_fast = 0;
			}
		}
	#endif
		//--------------充电fast检测断开充电-------------------//

		math_dword = ad_cal_dword;
		math_word = ad_sum;
		Math_Dword_Div_Word();
		if(flag_mos_pre && (flag_smoking || flag_pre_heat))
		{
			if(math_dword > mos_duty_max)				mos_duty = mos_duty_max;
			elseif(math_dword < mos_duty_max*160/430)	mos_duty = mos_duty_max*160/430;
			else										mos_duty = math_dword;
		}

		ad_turn = 0;
	}
}


//-----------------------------------------//
//---------------AD重置处理----------------//
//-----------------------------------------//
void ad_reset(void)
{
	p_check_io_in();
	ad_turn = 0;
	ad_count = 0;
	ad_sum = 0;
//  $ adcc enable, ADC;
  $ adcc enable, BANDGAP; //363
	AD_Start = 1;
}